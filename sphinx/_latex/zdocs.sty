% zdocs.sty -- the look of a zdocs PDF.
%
% zdocs_conf loads this package after Sphinx's own (\usepackage{sphinx}), and
% then a consumer's style file, if the document gives one (configure(...,
% latex_style=...)). This package changes the Sphinx layout only through what
% Sphinx documents: its page styles "normal" and "plain", its macros
% \sphinxtableofcontents and \sphinxmaketitle, and \sphinxsetup. It does not
% copy or patch sphinx.sty.
%
% It loads no package that a Sphinx xelatex build does not load already, so a
% TeX installation that builds a Sphinx PDF also builds a zdocs PDF.
%
% Settings: \zdsetup{key=value, ...}. zdocs_conf sets the values that come
% from the build; a consumer's style file can set any of them again:
%
%   title     the running header, left (default: the document title)
%   version   the running header, right (default: the document version)
%   footer    the running footer, left (default: Copyright <year> <holder>)
%   docid     the document ID in the registry (title page)
%   set       the PDFs of the set that this one links to, each as
%             \zdsetfile{<file name>} (title page)
%
% Colors: \definecolor (xcolor) again in a consumer's style file.
%
%   zdRule    the lines of the running header and footer
%   zdMuted   the text of the running header and footer
%   zdLabel   a label: of a field in a need card, of a row on the title page

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{zdocs}[2026/10/14 zdocs PDF layout]

\RequirePackage{keyval}
\RequirePackage{xcolor}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
% For tables and figures in a consumer's documents (raw LaTeX).
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{graphicx}

% -- Settings ----------------------------------------------------------------

\def\zd@title{}
\def\zd@version{}
\def\zd@footer{}
\def\zd@docid{}
\def\zd@set{}
\define@key{zd}{title}{\def\zd@title{#1}}
\define@key{zd}{version}{\def\zd@version{#1}}
\define@key{zd}{footer}{\def\zd@footer{#1}}
\define@key{zd}{docid}{\def\zd@docid{#1}}
\define@key{zd}{set}{\def\zd@set{#1}}
\newcommand{\zdsetup}[1]{\setkeys{zd}{#1}}

\definecolor{zdRule}{gray}{0.55}
\definecolor{zdMuted}{gray}{0.30}
\definecolor{zdLabel}{gray}{0.40}

% -- Fonts -------------------------------------------------------------------
%
% One family for the text: the body uses the sans-serif font that Sphinx
% already uses for the headings and the title page (FreeSans by default under
% xelatex). The code font stays Sphinx's monospaced font. To change the fonts,
% set them in a consumer's style file with fontspec (\setsansfont,
% \setmonofont), or give Sphinx's latex_elements["fontpkg"].

\renewcommand{\familydefault}{\sfdefault}

% -- Running header and footer -------------------------------------------------
%
% A PDF leaves the deploy tree: it is printed, mailed and filed. The header
% says which document and which version a page belongs to. A printed
% controlled document that does not give its version is not a controlled
% document.
%
% Sphinx selects the page styles "normal" (body) and "plain" (first page of a
% part, contents) by name, so the package defines these two. The page count
% is the number of the last page; the title page has no number.

\newcommand{\zd@pagestyle}{%
  \fancyhf{}%
  \fancyhead[L]{\zd@title}%
  \fancyhead[R]{\zd@version}%
  \fancyfoot[L]{\zd@footer}%
  \fancyfoot[R]{\thepage/\pageref*{LastPage}}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \renewcommand{\footrulewidth}{0.4pt}%
  \def\headrule{{\color{zdRule}\hrule\@height\headrulewidth\@width\headwidth
    \vskip-\headrulewidth}}%
  \def\footrule{{\color{zdRule}\hrule\@width\headwidth\@height\footrulewidth}}%
}
\fancypagestyle{normal}{\zd@pagestyle}
\fancypagestyle{plain}{\zd@pagestyle}
% fancyhdr 4.1 and newer: the font of the header and footer text.
\ifdefined\fancyhfinit\fancyhfinit{\footnotesize\color{zdMuted}}\fi

% -- Title page ------------------------------------------------------------------
%
% The title and the version, then the data of the document: ID, date, author. If the
% PDF links to other PDFs of its set, the title page names their files: the
% links work only while the files are in one folder.
%
% Like Sphinx's own \sphinxmaketitle (sphinxmanual.cls): the PDF information
% (title, author), and no page anchor on the title page.

\definecolor{zdTitleRule}{gray}{0.25}

\newcommand{\zdsetfile}[1]{\item[]\texttt{#1}}

\newcommand{\zd@titlerow}[2]{%
  \if\relax\detokenize{#2}\relax\else
    {\color{zdLabel}#1} & #2\\[0.25\baselineskip]
  \fi
}

\renewcommand{\sphinxmaketitle}{%
  \let\sphinxrestorepageanchorsetting\relax
  \ifHy@pageanchor\def\sphinxrestorepageanchorsetting{\Hy@pageanchortrue}\fi
  \hypersetup{pageanchor=false}%
  \begin{titlepage}%
    \begingroup
      \def\endgraf{ }\def\and{\& }%
      \pdfstringdefDisableCommands{\def\\{, }}%
      \hypersetup{pdfauthor={\@author}, pdftitle={\@title}}%
    \endgroup
    \raggedright
    \vspace*{0.12\textheight}%
    {\color{zdTitleRule}\rule{\linewidth}{1.5pt}}\par
    \vspace{1.2\baselineskip}%
    {\py@HeaderFamily\Huge\@title\par}%
    \vspace{0.6\baselineskip}%
    {\Large\zd@version\par}%
    \vspace{1.2\baselineskip}%
    {\color{zdTitleRule}\rule{\linewidth}{0.4pt}}\par
    \vspace{2\baselineskip}%
    \begin{tabular}{@{}l@{\hspace{2em}}l@{}}
      \zd@titlerow{Document}{\zd@docid}%
      \zd@titlerow{Date}{\@date}%
      \zd@titlerow{Author}{\@author}%
    \end{tabular}\par
    \vfill
    \ifx\zd@set\@empty\else
      {\small
       \textbf{Linked documents.} This PDF links to the PDFs below. The links
       work while these files are in the same folder as this one, with these
       names.\par
       \begin{itemize}\setlength{\itemsep}{0pt}\zd@set\end{itemize}}%
      \vspace{\baselineskip}%
    \fi
    {\small\color{zdMuted}\zd@footer\par}%
  \end{titlepage}%
  \setcounter{footnote}{0}%
  \let\thanks\relax\let\maketitle\relax
  \clearpage
  \sphinxrestorepageanchorsetting
}

% -- Contents ------------------------------------------------------------------
%
% Sphinx puts the contents on a page of their own, under a chapter-size
% heading (fncychap), and numbers that page in roman numerals. A controlled
% document of a few dozen pages needs neither: the contents come after the
% title page under a section-size heading, and the text follows on the same
% page. The pages are numbered 1, 2, ... from the contents on, so the page
% count in the footer is the number of pages after the title page.

\renewcommand{\sphinxtableofcontents}{%
  \begingroup
    \parskip\z@skip
    \sphinxtableofcontentshook
    {\py@HeaderFamily\Large\contentsname\par}%
    \medskip
    \@starttoc{toc}%
  \endgroup
  \par\bigskip
}

% -- Sections ------------------------------------------------------------------
%
% Top-level headings are \section, not \chapter (latex_toplevel_sectioning):
% no "Chapter N" banner and no page break before each one.
%
% \thesection must then be \arabic{section}. In this document class it is
% \thechapter.\arabic{section}, and with no \chapter the chapter counter stays
% 0, so each heading has the number 0.1, 0.2, 0.3.

\renewcommand{\thesection}{\arabic{section}}

% -- Back matter -----------------------------------------------------------------
%
% No index and no glossary at the end. Sphinx adds an index to a document of
% the manual class; for a controlled document it is a page of nothing, as the
% terms are in the glossary that the document includes.

\let\printindex\relax
\let\printglossary\relax
\let\printglossaries\relax

% -- Long names and tables ------------------------------------------------------
%
% Zephyr names are long and have no spaces: CONFIG_SAFE_DATA_LOCK_TIMEOUT_MS,
% TC_SAFE_DATA_WRITE_RESEALS. TeX does not break them, so in a table cell they
% go past the edge of the page. In a table and in a need card, a line can
% break after an underscore (\zdunderscorebreaks; penalty 100, so a space is
% still the better break). Not in the text of a page: there a name stays one
% word. (A link target is not changed: \sphinxhref reads its URL again,
% without this macro.)

\newcommand{\zdunderscorebreaks}{%
  \DeclareRobustCommand{\_}{%
    \ifmmode\nfss@text{\textunderscore}\else\textunderscore\penalty100\relax\fi}%
}
% Sphinx starts each table with one of these two macros, in a group.
\g@addto@macro\sphinxattablestart{\zdunderscorebreaks}
\g@addto@macro\sphinxatlongtablestart{\zdunderscorebreaks}

% Sphinx sets a table without given widths with tabulary, which gives each
% column a width in proportion to its text. A column of short values (need
% IDs) then becomes so narrow that each value breaks in two. A column is at
% least \tymin wide.

\setlength{\tymin}{5.5em}

% A need table (pdf_tables): ragged right, as a narrow column of justified
% text has large gaps. One that is too wide for the line: a smaller font and
% less padding in the cells.
% A cell resets the paragraph settings (array, varwidth), so the right margin
% is set where Sphinx starts each paragraph (\sphinxAtStartPar). Not with
% \raggedright: it changes \\, which ends a table row.
\newenvironment{sphinxclasszd-needtable}{%
  \def\sphinxAtStartPar{\rightskip\z@\@plus 2em\relax\leavevmode\nobreak\hskip\z@skip}%
}{}
\newenvironment{sphinxclasszd-table-small}{\footnotesize\setlength{\tabcolsep}{3pt}}{}
\newenvironment{sphinxclasszd-table-smaller}{\scriptsize\setlength{\tabcolsep}{3pt}}{}

% -- Need cards ------------------------------------------------------------------
%
% The need_cards extension writes each zdocs card (need_layout()) as:
%
%   \begin{zdneed}{<accent RRGGBB>}
%   \zdneedhead{<type>}{<ID>}{<tone>}{<status>}
%   \zdneedtitle{<title>}
%   <text of the need>
%   \zdneedfield{<label>}{<value>}      (each field and link)
%   \end{zdneed}
%
% The card has no background, so that it prints well: a bar in the accent
% color of its type on the left, the title in bold, then the text, then the
% fields and links with their labels in one column. The status is a framed
% badge in the color of its tone: good (passed), bad (failed), gap (partial),
% none (skipped, not run) or accent (any other status, in the type color).
% The card breaks across pages (framed).
%
% A consumer's style file can change the colors (\definecolor) and the
% width of the label column (\setlength{\zdneedlabelwidth}{...}), or define
% the macros again (\renewcommand, \renewenvironment).

\RequirePackage{framed}

\definecolor{zdTonegood}{HTML}{116329}
\definecolor{zdTonebad}{HTML}{A40E26}
\definecolor{zdTonegap}{HTML}{7D4E00}
\definecolor{zdTonenone}{HTML}{424A53}
\newlength{\zdneedlabelwidth}
\setlength{\zdneedlabelwidth}{7em}
\newif\ifzd@needfields

\newenvironment{zdneed}[1]{%
  \par\addvspace{1.1\baselineskip}%
  \definecolor{zdAccent}{HTML}{#1}%
  \colorlet{zdToneaccent}{zdAccent}%
  \zdunderscorebreaks
  \zd@needfieldsfalse
  \def\FrameCommand{{\color{zdAccent}\vrule\@width 2pt}\hspace{0.9em}}%
  \MakeFramed{\advance\hsize-\width\FrameRestore}%
}{%
  \par\endMakeFramed
  \par\addvspace{1.1\baselineskip}%
}

% The status badge: text and frame in the color of the tone.
\newcommand{\zdneedbadge}[2]{%
  {\color{zdTone#1}\fboxsep=1.5pt\fboxrule=0.6pt
   \fbox{\footnotesize\bfseries\vphantom{Ag}\,#2\,}}%
}

\newcommand{\zdneedhead}[4]{%
  \par\noindent
  {\raggedright
   {\color{zdAccent}\footnotesize\bfseries #1}\hspace{0.6em}%
   {\small\bfseries #2}%
   \if\relax\detokenize{#4}\relax\else\hfill\zdneedbadge{#3}{#4}\fi
   \par}%
  \nobreak
}

\newcommand{\zdneedtitle}[1]{%
  \vspace{0.15\baselineskip}%
  \noindent{\large\bfseries #1\par}%
  \nobreak\vspace{0.35\baselineskip}%
}

% A label wider than the column goes on a line of its own.
\newcommand{\zdneedfield}[2]{%
  \par
  \ifzd@needfields\else
    \zd@needfieldstrue\addvspace{0.5\baselineskip}%
    \parskip\z@skip
  \fi
  \sbox\z@{\footnotesize #1}%
  \noindent
  \ifdim\wd\z@>\dimexpr\zdneedlabelwidth-0.5em\relax
    {\color{zdLabel}\usebox\z@}\par\nobreak\noindent\hspace*{\zdneedlabelwidth}%
  \else
    \makebox[\zdneedlabelwidth][l]{\color{zdLabel}\usebox\z@}%
  \fi
  \hangindent\zdneedlabelwidth\hangafter\@ne
  {\small #2\par}%
}

% -- Signature lines -----------------------------------------------------------
%
% The doc_control extension writes the sign-off block of the PDF with
% \signatureline{<role>}{<name>}. The macro is always defined: an unused
% macro costs nothing, an undefined one stops xelatex ("Undefined control
% sequence").

\newcommand{\signatureline}[2]{%
  \noindent\textbf{#1}\par
  \vspace{0.35cm}%
  \noindent#2\par
  \vspace{0.20cm}%
  \noindent\makebox[\linewidth]{\rule{0pt}{0.5pt}\hrulefill}\par
  \vspace{0.85cm}%
}

\endinput
